# API base URL the app calls. A trailing slash is fine.
#
# Copy the line you need into app/.env.local (gitignored), then restart
# `npx expo start` and reload the app. See app/README.md for details.

# Local development. This is also the default when the variable is unset in development.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Android emulator: the emulator reaches your computer at 10.0.2.2.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Physical device (Expo Go or a development build): your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Production: the Cloud Run URL of shelfkin-api (`terraform output api_url` in infra/).
# Production builds must set this; without it the app shows a configuration error.
# EXPO_PUBLIC_API_URL=https://shelfkin-api-xxxxxxxxxx-uc.a.run.app
