# API base URL the app calls, and the Firebase project it signs in with.
#
# Copy the line you need into app/.env.local (gitignored), then restart
# `npx expo start` and reload the app. See app/README.md for details.

# --- API -----------------------------------------------------------------------
#
# Local development (a trailing slash is fine). This is also the default when the
# variable is unset in development.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Android emulator: the emulator reaches your computer at 10.0.2.2.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Physical device (Expo Go or a development build): your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Production: the Cloud Run URL of shelfkin-api (`terraform output api_url` in infra/).
# Production builds must set this; without it the app shows a configuration error.
# EXPO_PUBLIC_API_URL=https://shelfkin-api-xxxxxxxxxx-uc.a.run.app

# --- Sign-in (Firebase Auth) ---------------------------------------------------
#
# Development: leave the three Firebase values unset (the app then uses the
# Auth emulator's demo-shelfkin project) and point the app at the emulator from
# compose.yaml (`npm run db:up`). The host is the same computer as the API:
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Android emulator:
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=10.0.2.2:9099

# Physical device: your computer's LAN IP.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=192.168.1.20:9099

# Production: the production Firebase web app config (`terraform output
# firebase_web_config` in infra/). Production builds must set all three and must
# NOT set EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST; otherwise the app shows a
# configuration error.
# EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=shelfkin.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=<production project id>
