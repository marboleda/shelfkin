# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
project_id        = "shelfkin-prod"
region            = "us-central1"
billing_account   = "000000-000000-000000"
hosting_site_id   = "shelfkin"
budget_amount     = 25
github_repository = "marboleda/shelfkin"
alert_email       = "you@example.com"

# Optional (#40):
# scheduler_region          = "us-central1" # only if Cloud Scheduler is not offered in region
# expo_access_token_enabled = true          # only after adding a version to expo-access-token
